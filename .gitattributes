# 默认按文本处理，仓库内统一使用 LF；Windows 上由 Git 自动转换工作区换行
* text=auto

*.cpp   text diff=cpp
*.h     text diff=cpp
*.hpp   text diff=cpp
*.cmake text
CMakeLists.txt text
*.md    text
*.json  text
*.rc    text eol=crlf
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sh    text eol=lf

# 二进制资源
*.ico   binary
*.png   binary
*.jpg   binary
*.svg   text
*.ttf   binary
*.db    binary
*.kcdb  binary

# 让 GitHub 语言统计忽略自绘/生成的资源
resources/icons/* linguist-documentation
docs/* linguist-documentation
